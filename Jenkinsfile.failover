// Manual failover job: verify the primary is down, fence it, promote the
// standby and repoint db.internal. Tick FORCE to fail over a healthy primary
// (the script then stops the primary itself during fencing).
pipeline {
  agent any

  parameters {
    booleanParam(name: 'FORCE', defaultValue: false,
      description: 'Fail over even if the primary still responds')
  }

  options {
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 20, unit: 'MINUTES')
  }

  environment {
    REPO_DIR = '/home/shristy/ha-postgres-aws'
    FORCE    = "${params.FORCE ? '1' : '0'}"
  }

  stages {
    // The laptop's public IP changes between networks; refresh it first.
    stage('Allow my IP') {
      steps {
        dir(env.REPO_DIR) {
          sh './scripts/allow_my_ip.sh'
        }
      }
    }

    stage('Failover') {
      steps {
        dir(env.REPO_DIR) {
          sh './scripts/failover.sh'
        }
      }
    }
  }
}
