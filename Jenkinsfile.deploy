// One job, three actions: deploy, failover or destroy.
// Pick the action with "Build with Parameters".
pipeline {
  agent any

  parameters {
    choice(name: 'ACTION', choices: ['deploy', 'failover', 'destroy'],
      description: 'deploy = build + configure + validate, failover = fence/promote/DNS, destroy = tear everything down')
    booleanParam(name: 'FORCE', defaultValue: false,
      description: 'Only for failover: fail over even if the primary still responds')
  }

  options {
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 40, unit: 'MINUTES')
  }

  environment {
    REPO_DIR = '/home/shristy/ha-postgres-aws'
    // failover.sh reads FORCE from the environment (1 = force)
    FORCE    = "${params.FORCE ? '1' : '0'}"
  }

  stages {
    // The laptop's public IP changes between networks; refresh it first.
    // Not needed for destroy.
    stage('Allow my IP') {
      when { expression { params.ACTION != 'destroy' } }
      steps {
        dir(env.REPO_DIR) {
          sh './scripts/allow_my_ip.sh'
        }
      }
    }

    // ---------- ACTION = deploy ----------
    stage('Terraform apply') {
      when { expression { params.ACTION == 'deploy' } }
      steps {
        dir(env.REPO_DIR) {
          sh 'terraform init -input=false'
          sh 'terraform apply -auto-approve -input=false'
        }
      }
    }

    // Ansible must not start before sshd is up on every instance.
    stage('Wait for SSH') {
      when { expression { params.ACTION == 'deploy' } }
      steps {
        sh '''#!/bin/bash
set -u
for host in bastion primary standby; do
  ok=0
  for i in $(seq 1 30); do
    if ssh -o BatchMode=yes -o ConnectTimeout=10 "$host" true 2>/dev/null; then
      ok=1
      break
    fi
    echo "Waiting for SSH on $host ($i/30)"
    sleep 10
  done
  if [ "$ok" != "1" ]; then
    echo "SSH to $host did not become ready"
    exit 1
  fi
done
echo "SSH is ready on all hosts"
'''
      }
    }

    // The primary is configured before the standby (see site.yml).
    stage('Ansible configure') {
      when { expression { params.ACTION == 'deploy' } }
      steps {
        dir("${env.REPO_DIR}/ansible") {
          sh 'ansible-playbook site.yml'
        }
      }
    }

    stage('Validate') {
      when { expression { params.ACTION == 'deploy' } }
      steps {
        dir(env.REPO_DIR) {
          sh './tests/validate.sh'
        }
      }
    }

    // ---------- ACTION = failover ----------
    stage('Failover') {
      when { expression { params.ACTION == 'failover' } }
      steps {
        dir(env.REPO_DIR) {
          sh './scripts/failover.sh'
        }
      }
    }

    // ---------- ACTION = destroy ----------
    // Manual confirmation guards against accidental runs.
    stage('Confirm destroy') {
      when { expression { params.ACTION == 'destroy' } }
      steps {
        input message: 'Destroy ALL infrastructure (VPC, EC2, NAT, DNS, backup bucket)?', ok: 'Destroy'
      }
    }

    stage('Terraform destroy') {
      when { expression { params.ACTION == 'destroy' } }
      steps {
        dir(env.REPO_DIR) {
          sh 'terraform init -input=false'
          sh 'terraform destroy -auto-approve -input=false'
        }
      }
    }
  }
}
